     }
diff --git a/util/ios-jit.c b/util/ios-jit.c
new file mode 100644
index 0000000..3b8e1b5
--- /dev/null
+++ b/util/ios-jit.c
@@ -0,0 +1,207 @@
+/*
+ * JIT on iOS (AndroiOS): debugger-attached JIT, iOS 26+ TXM aware.
+ *
+ * iOS lets a process create executable pages only while a debugger is (or
+ * was) attached (CS_DEBUGGED). On iOS 26+ devices with the Trusted Execution
+ * Monitor (TXM: A15 and later), that is not enough: the debugger must also
+ * "prepare" each executable region. StikDebug's universal.js implements this
+ * as a breakpoint protocol:
+ *
+ *   x16 = 1 (PREPARE_REGION), x0 = addr (or 0), x1 = len; brk #0xf00d
+ *       -> debugger prepares [addr, addr+len) as RX, returns addr in x0
+ *   x16 = 0 (DETACH); brk #0xf00d
+ *       -> debugger detaches
+ *
+ * (The older "brk #0x69" handshake is rejected by current universal.js.)
+ * The same flow is used by RetroArch's pkg/apple/JITSupport.m.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu-ios-api.h"
+
+#ifdef __APPLE__
+#include <TargetConditionals.h>
+#endif
+
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+#include <os/log.h>
+#include <signal.h>
+#include <dirent.h>
+
+extern int csops(pid_t pid, unsigned int ops, void *useraddr, size_t usersize);
+#define CS_OPS_STATUS 0
+#define CS_DEBUGGED   0x10000000
+
+static os_log_t jit_log(void)
+{
+    static os_log_t log;
+    if (!log) {
+        log = os_log_create("com.androios.qemu", "jit");
+    }
+    return log;
+}
+
+int qemu_ios_jit_debugged(void)
+{
+    uint32_t flags = 0;
+    return csops(getpid(), CS_OPS_STATUS, &flags, sizeof(flags)) == 0 &&
+           (flags & CS_DEBUGGED) != 0;
+}
+
+int qemu_ios_jit_is_ios26(void)
+{
+    if (__builtin_available(iOS 26.0, *)) {
+        return 1;
+    }
+    return 0;
+}
+
+/* Look for <preboot>/<boot-uuid>/usr/standalone/firmware/FUD/Ap,TrustedExecutionMonitor.img4
+ * (96-character boot-manifest directory names), as RetroArch does. */
+static int find_txm_firmware(const char *base, int *checked)
+{
+    DIR *d = opendir(base);
+    struct dirent *e;
+    int found = 0;
+
+    if (!d) {
+        return 0;
+    }
+    while (!found && (e = readdir(d)) != NULL) {
+        if (strlen(e->d_name) == 96) {
+            char path[1024];
+            snprintf(path, sizeof(path),
+                     "%s/%s/usr/standalone/firmware/FUD/Ap,TrustedExecutionMonitor.img4",
+                     base, e->d_name);
+            *checked = 1;
+            found = access(path, F_OK) == 0;
+        }
+    }
+    closedir(d);
+    return found;
+}
+
+int qemu_ios_jit_device_has_txm(void)
+{
+    static int has_txm = -1;
+
+    if (has_txm >= 0) {
+        return has_txm;
+    }
+    has_txm = 0;
+    if (!qemu_ios_jit_is_ios26()) {
+        return has_txm;     /* only iOS 26+ enforces TXM for JIT */
+    }
+
+    int checked = 0;
+    DIR *d = opendir("/System/Volumes/Preboot");
+    struct dirent *e;
+    while (d && !has_txm && (e = readdir(d)) != NULL) {
+        if (strlen(e->d_name) == 36) {      /* <boot UUID> */
+            char boot[512];
+            snprintf(boot, sizeof(boot), "/System/Volumes/Preboot/%s/boot", e->d_name);
+            has_txm = find_txm_firmware(boot, &checked);
+            break;
+        }
+    }
+    if (d) {
+        closedir(d);
+    }
+    if (!has_txm) {
+        has_txm = find_txm_firmware("/private/preboot", &checked);
+    }
+    if (!has_txm && !checked) {
+        /* Could not inspect preboot: assume TXM. Preparing a region that did
+         * not need it only costs time; skipping one that did gets us killed. */
+        has_txm = 1;
+    }
+    os_log(jit_log(), "TXM: %{public}s%{public}s", has_txm ? "yes" : "no",
+           checked ? "" : " (assumed: preboot unreadable)");
+    return has_txm;
+}
+
+/* A brk with no debugger to handle it raises SIGTRAP; catch it so the
+ * missing-debugger case is an error instead of a crash. */
+static volatile sig_atomic_t brk_trapped;
+
+static void brk_trap_handler(int sig, siginfo_t *info, void *ctx)
+{
+    brk_trapped = 1;
+    ((ucontext_t *)ctx)->uc_mcontext->__ss.__pc += 4;   /* skip the brk */
+}
+
+static void brk_guard_begin(struct sigaction *prev)
+{
+    struct sigaction act = { 0 };
+
+    act.sa_sigaction = brk_trap_handler;
+    act.sa_flags = SA_SIGINFO;
+    sigemptyset(&act.sa_mask);
+    sigaction(SIGTRAP, &act, prev);
+    brk_trapped = 0;
+}
+
+static void brk_guard_end(struct sigaction *prev)
+{
+    sigaction(SIGTRAP, prev, NULL);
+}
+
+int qemu_ios_jit_prepare_region(void *rx, size_t size)
+{
+    struct sigaction prev;
+    register void *x0 __asm__("x0") = rx;
+    register size_t x1 __asm__("x1") = size;
+
+    brk_guard_begin(&prev);
+    __asm__ volatile("mov x16, #1\n"
+                     "brk #0xf00d\n"
+                     : "+r"(x0)
+                     : "r"(x1)
+                     : "x16", "memory");
+    brk_guard_end(&prev);
+
+    int ok = !brk_trapped && x0 == rx;
+    os_log(jit_log(), "prepare region %p+%zu MB: %{public}s", rx, size >> 20,
+           ok ? "ok" : (brk_trapped ? "no debugger handled brk #0xf00d (StikDebug script must be universal.js)"
+                                    : "debugger returned a different address"));
+    return ok;
+}
+
+void qemu_ios_jit_detach(void)
+{
+    struct sigaction prev;
+
+    brk_guard_begin(&prev);
+    __asm__ volatile("mov x16, #0\n"
+                     "brk #0xf00d\n" ::: "x16", "memory");
+    brk_guard_end(&prev);
+    os_log(jit_log(), "detach request: %{public}s",
+           brk_trapped ? "no debugger attached" : "sent");
+}
+
+void qemu_ios_jit_log(const char *msg)
+{
+    os_log(jit_log(), "%{public}s", msg);
+}
+
+void qemu_ios_log(const char *msg)
+{
+    static os_log_t log;
+    if (!log) {
+        log = os_log_create("com.androios.qemu", "qemu");
+    }
+    os_log(log, "%{public}s", msg);
+}
+
+#else /* not iOS: the macOS test harness */
+
+int qemu_ios_jit_debugged(void) { return 1; }
+int qemu_ios_jit_is_ios26(void) { return 0; }
+int qemu_ios_jit_device_has_txm(void) { return 0; }
+int qemu_ios_jit_prepare_region(void *rx, size_t size) { return 1; }
+void qemu_ios_jit_detach(void) { }
+void qemu_ios_jit_log(const char *msg) { }
+void qemu_ios_log(const char *msg) { }
+
+#endif
