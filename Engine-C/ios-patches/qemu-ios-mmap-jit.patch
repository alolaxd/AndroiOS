diff --git a/tcg/region.c b/tcg/region.c
index 478ec05..8f0bd7c 100644
--- a/tcg/region.c
+++ b/tcg/region.c
@@ -668,9 +668,71 @@ static int alloc_code_gen_buffer_splitwx_vmremap(size_t size, Error **errp)
 #endif /* CONFIG_DARWIN */
 #endif /* CONFIG_TCG_INTERPRETER */
 
+#if defined(CONFIG_DARWIN) && TARGET_OS_IPHONE
+#include "qemu-ios-api.h"
+
+/*
+ * iOS 26+: executable pages must start out RX (no MAP_JIT, no RW->RX flip).
+ * On TXM devices the attached debugger (StikDebug universal.js) prepares the
+ * region; then we make an RW alias for TCG to write through and detach the
+ * debugger, so QEMU's frequent signals no longer stop the process.
+ * See util/ios-jit.c.
+ */
+static int alloc_code_gen_buffer_splitwx_ios26(size_t size, Error **errp)
+{
+    char msg[160];
+    void *rx = mmap(NULL, size, PROT_READ | PROT_EXEC, MAP_PRIVATE | MAP_ANON, -1, 0);
+
+    if (rx == MAP_FAILED) {
+        error_setg_errno(errp, errno, "allocate %zu bytes for RX jit buffer", size);
+        return -1;
+    }
+    bool txm = qemu_ios_jit_device_has_txm();
+    if (txm && !qemu_ios_jit_prepare_region(rx, size)) {
+        munmap(rx, size);
+        error_setg(errp, "the debugger did not prepare the JIT region: "
+                   "enable JIT with StikDebug using the universal.js script");
+        return -1;
+    }
+
+    vm_address_t rw = 0;
+    vm_prot_t cur = 0, max = 0;
+    kern_return_t kr = vm_remap(mach_task_self(), &rw, size, 0, VM_FLAGS_ANYWHERE,
+                                mach_task_self(), (vm_address_t)rx, false,
+                                &cur, &max, VM_INHERIT_NONE);
+    if (kr != KERN_SUCCESS || mprotect((void *)rw, size, PROT_READ | PROT_WRITE) != 0) {
+        if (kr == KERN_SUCCESS) {
+            vm_deallocate(mach_task_self(), rw, size);
+        }
+        munmap(rx, size);
+        error_setg(errp, "could not create the RW alias of the JIT region (kr=%d)", kr);
+        return -1;
+    }
+
+    region.start_aligned = (void *)rw;
+    region.total_size = size;
+    tcg_splitwx_diff = (uintptr_t)rx - (uintptr_t)rw;
+
+    snprintf(msg, sizeof(msg), "code_gen_buffer %zu MB: rx=%p rw=%p (txm=%d)",
+             size >> 20, rx, (void *)rw, txm);
+    qemu_ios_jit_log(msg);
+    if (txm) {
+        qemu_ios_jit_detach();
+    }
+    return PROT_READ | PROT_WRITE;
+}
+#endif
+
 static int alloc_code_gen_buffer_splitwx(size_t size, Error **errp)
 {
 #ifndef CONFIG_TCG_INTERPRETER
+# if defined(CONFIG_DARWIN) && TARGET_OS_IPHONE
+    if (qemu_ios_jit_is_ios26()) {
