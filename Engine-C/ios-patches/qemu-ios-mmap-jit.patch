+    /* Before iOS 26, CS_DEBUGGED alone allows an RW buffer with an RX alias. */
+    qemu_ios_jit_log("code_gen_buffer: pre-iOS 26 split-wx (RW + RX alias)");
+# endif
 # ifdef CONFIG_DARWIN
     return alloc_code_gen_buffer_splitwx_vmremap(size, errp);
 # endif
@@ -687,6 +749,13 @@ static int alloc_code_gen_buffer(size_t size, int splitwx, Error **errp)
     ERRP_GUARD();
     int prot, flags;
 
+#if defined(CONFIG_DARWIN) && TARGET_OS_IPHONE
+    /*
+     * iOS has no pthread_jit_write_protect_np(), so a single MAP_JIT RWX
+     * buffer is unusable: split-wx is the only way TCG can JIT here.
+     */
+    splitwx = 1;
+#endif
     if (splitwx) {
