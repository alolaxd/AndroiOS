         if (prot >= 0) {
@@ -710,8 +779,9 @@ static int alloc_code_gen_buffer(size_t size, int splitwx, Error **errp)
      */
     prot = PROT_NONE;
     flags = MAP_PRIVATE | MAP_ANONYMOUS;
-#ifdef CONFIG_DARWIN
-    /* Applicable to both iOS and macOS (Apple Silicon). */
+#if defined(CONFIG_DARWIN) && !TARGET_OS_IPHONE
+    /* macOS (Apple Silicon): single MAP_JIT mapping toggled per thread.
+     * Never on iOS, where split-wx is forced above. */
     if (!splitwx) {
