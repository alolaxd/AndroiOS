diff --git a/include/qemu-ios-api.h b/include/qemu-ios-api.h
new file mode 100644
index 0000000..1ba5480
--- /dev/null
+++ b/include/qemu-ios-api.h
@@ -0,0 +1,86 @@
+/*
+ * Entry points exported by QEMU.framework (see qemu/system/ios-main.c).
+ * Consumed by the AndroiOS engine layer; not part of upstream QEMU.
+ */
+#ifndef QEMU_IOS_API_H
+#define QEMU_IOS_API_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QEMU_IOS_EXPORT __attribute__((visibility("default")))
+
+/* Runs QEMU to completion on the calling thread. Only once per process. */
+QEMU_IOS_EXPORT int qemu_ios_main(int argc, char **argv);
+
+QEMU_IOS_EXPORT char *qemu_ios_console_read(const char *chardev_id, int max_bytes);
+QEMU_IOS_EXPORT int qemu_ios_console_write(const char *chardev_id, const uint8_t *buf, int len);
+QEMU_IOS_EXPORT void qemu_ios_free(void *p);
+
+QEMU_IOS_EXPORT void qemu_ios_request_shutdown(void);
+QEMU_IOS_EXPORT void qemu_ios_pause(void);
+QEMU_IOS_EXPORT void qemu_ios_resume(void);
+QEMU_IOS_EXPORT int qemu_ios_is_running(void);
+
+/* ---- display (-display ios[,gl=es]) ------------------------------------
+ * Called on QEMU's main thread whenever a new frame is in the IOSurface.
+ * The IOSurfaceRef stays valid until the next callback reports a different
+ * one (resolution change); retain it if you keep it longer. */
+typedef void (*qemu_ios_frame_callback)(void *iosurface, int width, int height,
+                                        uint64_t seq, void *ctx);
+QEMU_IOS_EXPORT void qemu_ios_display_set_callback(qemu_ios_frame_callback cb, void *ctx);
+/* Frame completion: `mtl_shared_event` is an id<MTLSharedEvent> on the system
+ * default device. Each frame's seq is signalled on it once the frame is ready to
+ * sample: by the GPU (ANGLE) on the GL path, or through `cpu_signal` otherwise. */
+QEMU_IOS_EXPORT void qemu_ios_display_set_sync_event(void *mtl_shared_event,
+                                                      void (*cpu_signal)(void *event, uint64_t value));
+
+/* ---- input (virtio-multitouch-pci / virtio-keyboard-pci) ---------------- */
+enum { QEMU_IOS_TOUCH_DOWN = 0, QEMU_IOS_TOUCH_MOVE = 1, QEMU_IOS_TOUCH_UP = 2,
+       QEMU_IOS_TOUCH_CANCEL = 3 };
+/* x/y are in a w×h coordinate space (usually the guest display size). */
+QEMU_IOS_EXPORT void qemu_ios_send_touch(int slot, int tracking_id, int x, int y,
+                                         int w, int h, int action);
+QEMU_IOS_EXPORT void qemu_ios_send_key(int linux_keycode, int down);
+
+/* ---- memory pressure ----------------------------------------------------
+ * Shrink the guest via virtio-balloon (target size in MB). 0 on success. */
+QEMU_IOS_EXPORT int qemu_ios_balloon_target_mb(int64_t target_mb);
+
+/* ---- state save (migration to a file) -----------------------------------
+ * Pauses the guest and writes its full state to `path`. Blocks until done.
+ * Returns 0 on success, -1 if the device set is not migratable (e.g.
+ * virtio-gpu-gl with virgl) or the write failed; `err` gets a message.
+ * Restore by starting QEMU with: -incoming file:<path> */
+QEMU_IOS_EXPORT int qemu_ios_save_state(const char *path, char *err, int err_len);
+
+/* ---- audio (-audiodev ios,id=snd0) ---------------------------------------
+ * Called on QEMU's audio timer with interleaved native-endian s16 PCM. */
+typedef void (*qemu_ios_audio_callback)(const int16_t *frames, int frame_count,
+                                        int sample_rate, int channels, void *ctx);
+QEMU_IOS_EXPORT void qemu_ios_audio_set_callback(qemu_ios_audio_callback cb, void *ctx);
+
+/* ---- JIT (util/ios-jit.c) -------------------------------------------------
+ * iOS 26+ on TXM devices (A15+) requires the attached debugger to prepare
+ * executable regions (StikDebug universal.js: brk #0xf00d, x16 = command). */
+QEMU_IOS_EXPORT int qemu_ios_jit_debugged(void);         /* CS_DEBUGGED set */
+QEMU_IOS_EXPORT int qemu_ios_jit_is_ios26(void);
+QEMU_IOS_EXPORT int qemu_ios_jit_device_has_txm(void);   /* iOS 26+ with TXM */
+QEMU_IOS_EXPORT int qemu_ios_jit_prepare_region(void *rx, size_t size);
+QEMU_IOS_EXPORT void qemu_ios_jit_detach(void);
+QEMU_IOS_EXPORT void qemu_ios_jit_log(const char *msg);  /* os_log, subsystem com.androios.qemu */
+QEMU_IOS_EXPORT void qemu_ios_log(const char *msg);      /* os_log, category "qemu" */
+
+/* ---- internal: implemented in ui/ios.c, BQL must be held --------------- */
+void qemu_ios_input_touch(int slot, int tracking_id, int x, int y, int w, int h, int action);
+void qemu_ios_input_key_linux(int linux_keycode, int down);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
