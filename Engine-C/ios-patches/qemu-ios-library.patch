diff --git a/system/ios-main.c b/system/ios-main.c
new file mode 100644
index 0000000..617a271
--- /dev/null
+++ b/system/ios-main.c
@@ -0,0 +1,227 @@
+/*
+ * iOS in-process entry points for QEMU (AndroiOS).
+ *
+ * iOS forbids fork()/exec(), so QEMU is linked into the app as a dylib and
+ * driven from a background thread. These functions are the only symbols the
+ * host app calls; everything else stays internal to QEMU.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/main-loop.h"
+#include "sysemu/sysemu.h"
+#include "sysemu/runstate.h"
+#include "chardev/char.h"
+#include "chardev/char-fe.h"
+#include "qapi/error.h"
+#include "qapi/qapi-commands-char.h"
+#include "qapi/qapi-commands-migration.h"
+#include "migration/misc.h"
+#include "qapi/qapi-commands-machine.h"
+#include <pthread/qos.h>
+#include "qemu-ios-api.h"
+
+static volatile int ios_started;
+/* Set once qemu_init() has created the BQL and chardevs; cleared before
+ * teardown. Every host-thread entry point checks it first. */
+static volatile int ios_ready;
+
+static bool ios_enter(void)
+{
+    if (!__atomic_load_n(&ios_ready, __ATOMIC_ACQUIRE)) {
+        return false;
+    }
+    bql_lock();
+    return true;
+}
+
+int qemu_ios_main(int argc, char **argv)
+{
+    int status;
+
+    if (__atomic_exchange_n(&ios_started, 1, __ATOMIC_SEQ_CST)) {
+        /* QEMU keeps process-global state; it can only run once per launch. */
+        return -1;
+    }
+    /*
+     * The main loop feeds the display, audio and virgl. iOS demotes default-QoS
+     * work when the UI is idle or the device is hot, so run it (and the vCPU
+     * threads it creates, which inherit this) at user-interactive QoS, as UTM does.
+     */
+    pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0);
+    qemu_init(argc, argv);
+    __atomic_store_n(&ios_ready, 1, __ATOMIC_RELEASE);
+    status = qemu_main_loop();
+    __atomic_store_n(&ios_ready, 0, __ATOMIC_RELEASE);
+    qemu_cleanup(status);
+    return status;
+}
+
+/*
+ * Console output: the guest serial port is wired to a "ringbuf" chardev.
+ * The host polls it. Returns a g_malloc'd NUL-terminated buffer (may be
+ * empty) that the caller frees with qemu_ios_free(), or NULL on error.
+ */
+char *qemu_ios_console_read(const char *chardev_id, int max_bytes)
+{
+    Error *err = NULL;
+    char *data;
+
+    if (!ios_enter()) {
+        return g_strdup("");
+    }
+    data = qmp_ringbuf_read(chardev_id, max_bytes, true, DATA_FORMAT_UTF8, &err);
+    bql_unlock();
+    if (err) {
+        error_free(err);
+        return NULL;
+    }
+    return data;
+}
+
+/* Console input: push bytes from the host into the guest UART. */
+int qemu_ios_console_write(const char *chardev_id, const uint8_t *buf, int len)
+{
+    Chardev *chr;
+    int n = 0;
+
+    if (!ios_enter()) {
+        return -1;
+    }
+    chr = qemu_chr_find(chardev_id);
+    if (chr) {
+        n = MIN(len, qemu_chr_be_can_write(chr));
+        if (n > 0) {
+            qemu_chr_be_write(chr, buf, n);
+        }
+    } else {
+        n = -1;
+    }
+    bql_unlock();
+    return n;
+}
+
+void qemu_ios_free(void *p)
+{
+    g_free(p);
+}
+
+void qemu_ios_request_shutdown(void)
+{
+    if (ios_enter()) {
+        qemu_system_shutdown_request(SHUTDOWN_CAUSE_HOST_UI);
+        bql_unlock();
+    }
+}
+
+void qemu_ios_pause(void)
+{
+    if (!ios_enter()) {
+        return;
+    }
+    if (runstate_is_running()) {
+        vm_stop(RUN_STATE_PAUSED);
+    }
+    bql_unlock();
+}
+
+void qemu_ios_resume(void)
+{
+    if (!ios_enter()) {
+        return;
+    }
+    if (!runstate_is_running()) {
+        vm_start();
+    }
+    bql_unlock();
+}
+
+int qemu_ios_is_running(void)
+{
+    return __atomic_load_n(&ios_ready, __ATOMIC_ACQUIRE) && runstate_is_running();
+}
+
+void qemu_ios_send_touch(int slot, int tracking_id, int x, int y, int w, int h, int action)
+{
+    if (ios_enter()) {
+        qemu_ios_input_touch(slot, tracking_id, x, y, w, h, action);
+        bql_unlock();
+    }
+}
+
+void qemu_ios_send_key(int linux_keycode, int down)
+{
+    if (ios_enter()) {
+        qemu_ios_input_key_linux(linux_keycode, down);
+        bql_unlock();
+    }
+}
+
+int qemu_ios_save_state(const char *path, char *errbuf, int err_len)
+{
+    Error *err = NULL;
+    g_autofree char *uri = g_strdup_printf("file:%s", path);
+    MigrationInfo *info;
+    int ret = -1;
+
+    if (!ios_enter()) {
+        g_strlcpy(errbuf, "VM not running", err_len);
+        return -1;
+    }
+    if (runstate_is_running()) {
+        vm_stop(RUN_STATE_PAUSED);
+    }
+    qmp_migrate(uri, false, NULL, false, false, false, false, &err);
+    bql_unlock();
+    if (err) {
+        g_strlcpy(errbuf, error_get_pretty(err), err_len);
+        error_free(err);
+        return -1;
+    }
+    /* Migration runs on its own thread; poll until it settles. */
+    for (;;) {
+        g_usleep(20 * 1000);
+        bql_lock();
+        info = qmp_query_migrate(NULL);
+        bql_unlock();
+        if (!info->has_status) {
+            qapi_free_MigrationInfo(info);
+            continue;
+        }
+        if (info->status == MIGRATION_STATUS_COMPLETED) {
+            ret = 0;
+        } else if (info->status == MIGRATION_STATUS_FAILED ||
+                   info->status == MIGRATION_STATUS_CANCELLED) {
+            g_strlcpy(errbuf, info->error_desc ? info->error_desc : "migration failed",
+                      err_len);
+        } else {
+            qapi_free_MigrationInfo(info);
+            continue;
+        }
+        qapi_free_MigrationInfo(info);
+        return ret;
+    }
+}
+
+/*
+ * Ask the guest's virtio-balloon driver to give memory back: set the guest's
+ * target size in MB. Pages the guest surrenders are released to iOS, which is
+ * what actually relieves memory pressure (pausing the VM frees nothing).
+ * Returns 0 on success, -1 if there is no balloon device or the VM isn't up.
+ */
+int qemu_ios_balloon_target_mb(int64_t target_mb)
+{
+    Error *err = NULL;
+
+    if (!ios_enter()) {
+        return -1;
+    }
+    qmp_balloon(target_mb << 20, &err);
+    bql_unlock();
+    if (err) {
+        error_free(err);
+        return -1;
+    }
+    return 0;
+}
